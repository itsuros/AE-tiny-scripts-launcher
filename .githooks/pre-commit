#!/bin/bash
set -e

# Automatically increment develop revision on every normal commit when channel == "develop"
# unless version.json is already modified in the staged index.

if [ -f ".git/MERGE_HEAD" ]; then
  exit 0
fi

NODE_BIN=""
for candidate in "$(command -v node 2>/dev/null || true)" /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    NODE_BIN="$candidate"
    break
  fi
done

if [ -z "$NODE_BIN" ]; then
  exit 0
fi

if git diff --cached --name-only | grep -qx "version.json"; then
  # version.json was already updated manually in this commit
  exit 0
fi

CHANNEL="$("$NODE_BIN" -e "console.log(JSON.parse(require('fs').readFileSync('version.json','utf8')).channel)")"
if [ "$CHANNEL" = "develop" ]; then
  "$NODE_BIN" scripts/bump-revision.js >/dev/null
  git add version.json js/version.js
fi
