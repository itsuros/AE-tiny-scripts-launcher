{
  "name": "ae-tiny-scripts-launcher",
  "version": "0.0.0",
  "description": "Adobe After Effects CEP Script, Expression, and FFX Preset Launcher with GitHub Sync and Auto-Update",
  "license": "MIT",
  "author": "Itsuro Sasakura",
  "repository": {
    "type": "git",
    "url": ""
  },
  "scripts": {
    "test": "node scripts/validate.js",
    "bump:rev": "node scripts/bump-revision.js",
    "setup:hooks": "git config core.hooksPath .githooks",
    "setup:mac": "bash scripts/install-dev.sh",
    "setup:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-dev.ps1"
  }
}
